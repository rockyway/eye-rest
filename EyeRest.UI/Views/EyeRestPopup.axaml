<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EyeRest.UI.Views.EyeRestPopup">
    <UserControl.Styles>
        <!-- Compact: same content, smaller icon/type/bar -->
        <Style Selector="Grid.compact Border#Glass"><Setter Property="Padding" Value="22,16" /></Style>
        <Style Selector="Grid.compact StackPanel#Content"><Setter Property="Spacing" Value="8" /></Style>
        <Style Selector="Grid.compact Panel#IconPanel"><Setter Property="Width" Value="52" /><Setter Property="Height" Value="52" /><Setter Property="Margin" Value="0" /></Style>
        <Style Selector="Grid.compact Border#IconOuter"><Setter Property="Width" Value="52" /><Setter Property="Height" Value="52" /><Setter Property="CornerRadius" Value="26" /></Style>
        <Style Selector="Grid.compact Border#IconInner"><Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /><Setter Property="CornerRadius" Value="22" /></Style>
        <Style Selector="Grid.compact PathIcon#IconGlyph"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /></Style>
        <Style Selector="Grid.compact TextBlock#TitleText"><Setter Property="FontSize" Value="16" /></Style>
        <Style Selector="Grid.compact TextBlock#InstructionText"><Setter Property="FontSize" Value="12" /><Setter Property="MaxWidth" Value="230" /></Style>
        <Style Selector="Grid.compact ProgressBar#ProgressBar"><Setter Property="Width" Value="230" /><Setter Property="Height" Value="5" /></Style>
        <Style Selector="Grid.compact TextBlock#TimeRemainingText"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="Grid.compact TextBlock#SkipHint"><Setter Property="IsVisible" Value="False" /></Style>

        <!-- Minimal: small notification, title + time + thin bar -->
        <Style Selector="Grid.minimal Border#Glass"><Setter Property="Padding" Value="14,10" /><Setter Property="CornerRadius" Value="12" /></Style>
        <Style Selector="Grid.minimal Border#Card"><Setter Property="CornerRadius" Value="12" /></Style>
        <Style Selector="Grid.minimal StackPanel#Content"><Setter Property="Spacing" Value="5" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
        <Style Selector="Grid.minimal Panel#IconPanel"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Grid.minimal TextBlock#TitleText"><Setter Property="FontSize" Value="13" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,24,0" /></Style>
        <Style Selector="Grid.minimal TextBlock#InstructionText"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Grid.minimal ProgressBar#ProgressBar"><Setter Property="Width" Value="NaN" /><Setter Property="Height" Value="3" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
        <Style Selector="Grid.minimal TextBlock#TimeRemainingText"><Setter Property="FontSize" Value="11" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
        <Style Selector="Grid.minimal TextBlock#SkipHint"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Grid.minimal Button#CloseButton"><Setter Property="Margin" Value="0,-6,-8,0" /></Style>
    </UserControl.Styles>
    <Grid Name="Root" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Single card: mesh gradient clipped to rounded border -->
        <Border Name="Card" Background="{DynamicResource MeshGradientBrush}"
                CornerRadius="20"
                ClipToBounds="True"
                Padding="0">
            <!-- Glass overlay -->
            <Border Name="Glass" Background="{DynamicResource GlassCardBackground}"
                    BorderBrush="{DynamicResource GlassCardBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="40,30">
                <Grid>
                    <StackPanel Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="16">
                        <!-- Nested Glass Circles with Eye Icon -->
                        <Panel Name="IconPanel" Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Border Name="IconOuter" Width="100" Height="100"
                                    CornerRadius="50"
                                    Background="{DynamicResource EyeRestIconCircle}" />
                            <Border Name="IconInner" Width="90" Height="90"
                                    CornerRadius="45"
                                    Background="{DynamicResource GlassCardBackground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <PathIcon Name="IconGlyph" Data="{DynamicResource EyeIcon}"
                                          Width="40" Height="40"
                                          Foreground="{DynamicResource NavButtonActiveText}" />
                            </Border>
                        </Panel>

                        <!-- Title -->
                        <TextBlock Name="TitleText" Text="Time for an Eye Rest!"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />

                        <!-- Instructions -->
                        <TextBlock Name="InstructionText" FontSize="16"
                                   Foreground="{DynamicResource ContentSubtitleText}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="300">
                            <Run Text="Please look at something " />
                            <Run Text="20ft (~6m)" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                            <Run Text=" away to rest your eyes" />
                        </TextBlock>

                        <!-- Progress Bar -->
                        <ProgressBar Name="ProgressBar"
                                     Width="300"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     IsIndeterminate="False"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource GlassPanelBackground}"
                                     HorizontalAlignment="Center" />

                        <!-- Time Remaining -->
                        <TextBlock Name="TimeRemainingText"
                                   Classes="MonoDigits"
                                   Text="20 seconds remaining"
                                   FontSize="14"
                                   Foreground="{DynamicResource ContentSubtitleText}"
                                   HorizontalAlignment="Center" />

                        <!-- Skip hint -->
                        <TextBlock Name="SkipHint" Text="Press ESC to skip"
                                   FontSize="12"
                                   Foreground="{DynamicResource ContentSubtitleText}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Name="CloseButton"
                            Classes="PopupCloseBtn"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-4,-4,0"
                            ToolTip.Tip="Skip eye rest (ESC)">
                        <PathIcon Data="{DynamicResource CloseIcon}"
                                  Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
