<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EyeRest.UI.Views.BreakPopup">
    <UserControl.Styles>
        <!-- Base (Standard) values live here, not as local attributes, so mode styles can override them -->
        <Style Selector="Border#OuterBorder"><Setter Property="CornerRadius" Value="24" /><Setter Property="Padding" Value="24" /></Style>
        <Style Selector="Border#Card"><Setter Property="CornerRadius" Value="24" /></Style>
        <Style Selector="Grid#Hero"><Setter Property="Margin" Value="0,0,0,24" /></Style>
        <Style Selector="TextBlock#MinutesDisplay"><Setter Property="FontSize" Value="120" /></Style>
        <Style Selector="TextBlock#SecondsDisplay"><Setter Property="FontSize" Value="120" /></Style>
        <Style Selector="StackPanel#MinutesBox"><Setter Property="Margin" Value="0,0,20,0" /></Style>
        <Style Selector="StackPanel#SecondsBox"><Setter Property="Margin" Value="20,0,0,0" /></Style>
        <Style Selector="Panel#IconPanel"><Setter Property="Height" Value="100" /><Setter Property="Margin" Value="20,0" /><Setter Property="Width" Value="100" /></Style>
        <Style Selector="Border#IconOuter"><Setter Property="CornerRadius" Value="50" /><Setter Property="Height" Value="100" /><Setter Property="Width" Value="100" /></Style>
        <Style Selector="Border#IconInner"><Setter Property="CornerRadius" Value="45" /><Setter Property="Height" Value="90" /><Setter Property="Width" Value="90" /></Style>
        <Style Selector="PathIcon#IconGlyph"><Setter Property="Height" Value="40" /><Setter Property="Width" Value="40" /></Style>
        <Style Selector="TextBlock#MainMessageText"><Setter Property="FontSize" Value="32" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="TextAlignment" Value="Center" /></Style>
        <Style Selector="TextBlock#InstructionText"><Setter Property="FontSize" Value="16" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
        <Style Selector="ProgressBar#ProgressBar"><Setter Property="Height" Value="12" /><Setter Property="Margin" Value="0,16,0,16" /><Setter Property="Width" Value="460" /></Style>
        <Style Selector="TextBlock#TimeRemainingText"><Setter Property="FontSize" Value="16" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
        <Style Selector="Button#ConfirmationButton"><Setter Property="FontSize" Value="16" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,15,0,0" /><Setter Property="Padding" Value="20,12" /></Style>
        <Style Selector="TextBlock#ReturnInstructionText"><Setter Property="FontSize" Value="14" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,10,0,0" /><Setter Property="TextAlignment" Value="Center" /></Style>
        <Style Selector="StackPanel#ContentStack"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
        <Style Selector="StackPanel#ActionButtonsPanel"><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Spacing" Value="8" /></Style>
        <Style Selector="Border#OuterBorder"><Setter Property="Width" Value="580" /><Setter Property="Height" Value="640" /></Style>

        <!-- Compact: smaller digits/icon/type, auto height, no extras -->
        <Style Selector="Grid.compact Border#OuterBorder"><Setter Property="Width" Value="400" /><Setter Property="Height" Value="NaN" /><Setter Property="Padding" Value="18" /><Setter Property="CornerRadius" Value="18" /></Style>
        <Style Selector="Grid.compact Border#Card"><Setter Property="CornerRadius" Value="18" /></Style>
        <Style Selector="Grid.compact Grid#Hero"><Setter Property="Margin" Value="0,0,0,10" /></Style>
        <Style Selector="Grid.compact TextBlock#MinutesDisplay"><Setter Property="FontSize" Value="52" /></Style>
        <Style Selector="Grid.compact TextBlock#SecondsDisplay"><Setter Property="FontSize" Value="52" /></Style>
        <Style Selector="Grid.compact StackPanel#MinutesBox"><Setter Property="Margin" Value="0,0,10,0" /></Style>
        <Style Selector="Grid.compact StackPanel#SecondsBox"><Setter Property="Margin" Value="10,0,0,0" /></Style>
        <Style Selector="Grid.compact Panel#IconPanel"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /><Setter Property="Margin" Value="10,0" /></Style>
        <Style Selector="Grid.compact Border#IconOuter"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /><Setter Property="CornerRadius" Value="24" /></Style>
        <Style Selector="Grid.compact Border#IconInner"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="CornerRadius" Value="20" /></Style>
        <Style Selector="Grid.compact PathIcon#IconGlyph"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /></Style>
        <Style Selector="Grid.compact TextBlock#MainMessageText"><Setter Property="FontSize" Value="18" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
        <Style Selector="Grid.compact TextBlock#InstructionText"><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
        <Style Selector="Grid.compact ProgressBar#ProgressBar"><Setter Property="Width" Value="340" /><Setter Property="Height" Value="6" /><Setter Property="Margin" Value="0,8" /></Style>
        <Style Selector="Grid.compact TextBlock#TimeRemainingText"><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
        <Style Selector="Grid.compact StackPanel#Extras"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Grid.compact StackPanel#Hints"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Grid.compact StackPanel#ActionButtonsPanel Button"><Setter Property="Padding" Value="10,5" /><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="Grid.compact Button#ConfirmationButton"><Setter Property="Padding" Value="14,8" /><Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,6,0,0" /></Style>
        <Style Selector="Grid.compact TextBlock#ReturnInstructionText"><Setter Property="FontSize" Value="11" /></Style>

        <!-- Minimal: small notification (title, time, thin bar, small actions) -->
        <Style Selector="Grid.minimal Border#OuterBorder"><Setter Property="Width" Value="320" /><Setter Property="Height" Value="NaN" /><Setter Property="Padding" Value="14,12" /><Setter Property="CornerRadius" Value="12" /></Style>
        <Style Selector="Grid.minimal Border#Card"><Setter Property="CornerRadius" Value="12" /></Style>
        <Style Selector="Grid.minimal StackPanel#ContentStack"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
        <Style Selector="Grid.minimal Grid#Hero"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Grid.minimal TextBlock#MainMessageText"><Setter Property="FontSize" Value="14" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="TextAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,0,2" /></Style>
        <Style Selector="Grid.minimal TextBlock#InstructionText"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Grid.minimal ProgressBar#ProgressBar"><Setter Property="Width" Value="NaN" /><Setter Property="Height" Value="3" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,6" /></Style>
        <Style Selector="Grid.minimal TextBlock#TimeRemainingText"><Setter Property="FontSize" Value="11" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
        <Style Selector="Grid.minimal StackPanel#Extras"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Grid.minimal StackPanel#Hints"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="Grid.minimal StackPanel#ActionButtonsPanel"><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Spacing" Value="6" /></Style>
        <Style Selector="Grid.minimal StackPanel#ActionButtonsPanel Button"><Setter Property="Padding" Value="8,4" /><Setter Property="FontSize" Value="11" /></Style>
        <Style Selector="Grid.minimal Button#ConfirmationButton"><Setter Property="Padding" Value="10,5" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,4,0,0" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
        <Style Selector="Grid.minimal TextBlock#ReturnInstructionText"><Setter Property="FontSize" Value="10" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="TextAlignment" Value="Left" /><Setter Property="Margin" Value="0,6,0,0" /></Style>
    </UserControl.Styles>
    <Grid Name="Root" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Single card: mesh gradient clipped to rounded border -->
        <Border Name="Card" Background="{DynamicResource MeshGradientBrush}"
               
                ClipToBounds="True"
                Padding="0">
            <!-- Glass overlay - Name="OuterBorder" preserved (code sets Background on completion) -->
            <!-- Fixed Width/Height keep the popup the same size between the active Break state -->
            <!-- and the Break-Complete state, regardless of the longer completion title (BL-003). -->
            <Border Name="OuterBorder"
                    Background="{DynamicResource GlassCardBackground}"
                    BorderBrush="{DynamicResource GlassCardBorder}"
                    BorderThickness="1"
                   
                    ClipToBounds="True"
                   >
                <StackPanel Name="ContentStack" VerticalAlignment="Center">
                    <!-- Enhanced Timer Display with Minutes and Seconds around Eye Icon -->
                    <Grid Name="Hero" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Minutes Display (Left) -->
                        <StackPanel Name="MinutesBox" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Name="MinutesDisplay"
                                       Classes="MonoDigits"
                                       Text="5"
                                      
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="minutes"
                                       FontSize="16"
                                       Foreground="{DynamicResource ContentSubtitleText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,-10,0,0"/>
                        </StackPanel>

                        <!-- Break Icon (Center) - Glass circle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Panel Name="IconPanel">
                                <Border Name="IconOuter"
                                       
                                        Background="{DynamicResource CompletionIconCircle}" />
                                <Border Name="IconInner"
                                       
                                        Background="{DynamicResource GlassCardBackground}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <PathIcon Name="IconGlyph" Data="{DynamicResource EyeIcon}"
                                             
                                              Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Panel>
                        </StackPanel>

                        <!-- Seconds Display (Right) -->
                        <StackPanel Name="SecondsBox" Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Name="SecondsDisplay"
                                       Classes="MonoDigits"
                                       Text="00"
                                      
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="seconds"
                                       FontSize="16"
                                       Foreground="{DynamicResource ContentSubtitleText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,-10,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Main Message -->
                    <TextBlock Name="MainMessageText"
                               Text="Time for a Break!"
                              
                               FontWeight="Bold"
                              
                               TextWrapping="Wrap"
                              
                               MaxWidth="600"
                              />

                    <!-- Instructions -->
                    <TextBlock Name="InstructionText" Text="Stand up, stretch, and move around to stay healthy"
                              
                               Foreground="{DynamicResource ContentSubtitleText}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                              />

                    <!-- Progress Bar -->
                    <ProgressBar Name="ProgressBar"
                                
                                
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 IsIndeterminate="False"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource GlassPanelBackground}"
                                
                                 BorderThickness="0"/>

                    <!-- Timer Label (set to "time extended" by code-behind during forward timer) -->
                    <TextBlock Name="TimerLabelText"
                               Text=""
                               FontSize="14"
                               Foreground="{DynamicResource ContentSubtitleText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <!-- Time Remaining -->
                    <TextBlock Name="TimeRemainingText"
                               Classes="MonoDigits"
                               Text="5 minutes remaining"
                              
                               Foreground="{DynamicResource ContentSubtitleText}"
                              
                              />

                    <!-- Stretching Resources -->
                    <StackPanel Name="Extras">
                    <TextBlock Text="Stretching Resources:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                        <Button Name="StretchingResource1"
                                Classes="ActionBtnPrimary"
                                Padding="12,6"
                                Margin="3"
                                Tag="https://www.healthline.com/health/deskercise">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{DynamicResource FitnessIcon}"
                                          Width="14" Height="14" />
                                <TextBlock Text="Deskercise Guide"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Name="ActionButtonsPanel"
                                Orientation="Horizontal"
                               
                                Margin="0,0,0,8"
                               >
                        <Button Name="DelayOneMinuteButton"
                                Classes="GradientPause"
                                Padding="15,8"
                                Cursor="Hand"
                                ToolTip.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{DynamicResource TimerAddIcon}"
                                          Width="14" Height="14" />
                                <TextBlock Text="Delay 1 Min"
                                           VerticalAlignment="Center" />
                                <Border Name="DelayOneMinuteLastChip"
                                        IsVisible="False"
                                        Background="#FFD32F2F"
                                        CornerRadius="6"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="LAST"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Name="DelayFiveMinutesButton"
                                Classes="GradientPause"
                                Padding="15,8"
                                Cursor="Hand"
                                ToolTip.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{DynamicResource TimerAddIcon}"
                                          Width="14" Height="14" />
                                <TextBlock Text="Delay 5 Min"
                                           VerticalAlignment="Center" />
                                <Border Name="DelayFiveMinutesLastChip"
                                        IsVisible="False"
                                        Background="#FFD32F2F"
                                        CornerRadius="6"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="LAST"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Name="SkipButton"
                                Classes="GradientStop"
                                Padding="15,8"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{DynamicResource CloseIcon}"
                                          Width="12" Height="12" />
                                <TextBlock Text="Skip Break"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Confirmation Button (Hidden by default, shown when break completes) -->
                    <Button Name="ConfirmationButton"
                            Classes="GradientStart"
                           
                           
                           
                            FontWeight="Bold"
                           
                            IsVisible="False"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{DynamicResource CheckCircleIcon}"
                                      Width="18" Height="18" />
                            <TextBlock Text="Done - Start Fresh Session"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Return instruction (Hidden by default) -->
                    <TextBlock Name="ReturnInstructionText"
                               Text="Click 'Done' when you return to start a fresh session"
                              
                               Foreground="{DynamicResource ContentSubtitleText}"
                              
                               TextWrapping="Wrap"
                              
                              
                               IsVisible="False"/>

                    <!-- Drag and close instructions -->
                    <StackPanel Name="Hints" HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                        <TextBlock Text="Drag window to move"
                                   FontSize="12"
                                   Foreground="{DynamicResource ContentSubtitleText}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Perfect for working on critical tasks"
                                   FontSize="10"
                                   Foreground="{DynamicResource ContentSubtitleText}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
